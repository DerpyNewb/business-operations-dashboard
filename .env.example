# Copy the value into your shell environment; app.py does not read .env files.
# Generate a new token: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPERATIONS_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# n8n: configure separate inbound Header Auth and outgoing HTTP Header Auth credentials.
# Outgoing header: Authorization; value: Bearer <OPERATIONS_API_TOKEN>.
